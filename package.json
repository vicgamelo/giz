{
  "name": "giz",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor-pyodide.mjs",
    "dev": "node scripts/vendor-pyodide.mjs && vite",
    "build": "node scripts/vendor-pyodide.mjs && vite build && node scripts/check-dist.mjs",
    "preview": "node scripts/serve-dist.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:py": "node scripts/pytest-pyodide.mjs",
    "test:py:native": "cd python && uv run pytest -q -W ignore"
  },
  "dependencies": {
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.6.6",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "vite": "8.1.7",
    "vitest": "5.1.0"
  }
}
